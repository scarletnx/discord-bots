#!/bin/sh
# PROVIDE: xuji
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# The xuji Discord bot, run by daemon(8) as the xuji user, started again when it stops; its output in syslog.
# Its tokens are in xuji_env_file (root's, mode 600), which rc.subr exports to it.

. /etc/rc.subr

name=xuji
rcvar=xuji_enable
load_rc_config $name

: ${xuji_enable:=NO}
: ${xuji_env_file:=/usr/local/etc/xuji.env}

pidfile=/var/run/${name}.pid
command=/usr/sbin/daemon
command_args="-f -r -R 30 -S -T ${name} -u ${name} -P ${pidfile} /usr/local/bin/python3.12 /usr/local/libexec/${name}.py"
start_precmd="${name}_precmd"

xuji_precmd()
{
	if [ ! -s "${xuji_env_file}" ] || grep -q '=$' "${xuji_env_file}"; then
		echo "${xuji_env_file} lacks a value: fill it in first"
		return 1
	fi
}

run_rc_command "$1"
