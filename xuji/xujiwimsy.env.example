# XujiWimsy's settings (an empty one stops it, naming the key):
#   install -d -m 700 ~/.config/xujiwimsy
#   install -m 600 xujiwimsy.env.example ~/.config/xujiwimsy/xujiwimsy.env     then fill it in
# XUJIWIMSY_TOKEN     the bot's token (Developer Portal, Bot, Reset Token)
# XUJIWIMSY_OWNER     the owner's user id, who approves every post (Developer Mode, Copy User ID)
# XUJIWIMSY_USERS     id,id: whose messages reach the session; the owner's always do
XUJIWIMSY_TOKEN=
XUJIWIMSY_OWNER=
XUJIWIMSY_USERS=
# Optional: where it reads and posts, their threads counting as them. Without the line, every channel and thread
# Discord lets the bot see.
# XUJIWIMSY_CHANNELS=id,id
